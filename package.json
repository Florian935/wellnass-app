{
  "name": "wellness-app",
  "version": "0.0.0",
  "private": true,
  "description": "Écosystème bien-être mobile (Musculation · Running · Nutrition) — monorepo",
  "license": "UNLICENSED",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "mobile": "npm run start --workspace @wellness/mobile",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:status": "supabase status",
    "db:push": "supabase db push",
    "db:push:dry": "supabase db push --dry-run",
    "db:new": "supabase migration new",
    "db:types": "supabase gen types typescript --project-id nsxzflxsgovriwwvflxe > packages/shared/src/database.types.ts"
  },
  "devDependencies": {
    "supabase": "^2.109.1"
  }
}
