# ==============================================================
#  Wellness App — .gitattributes
#  Normalisation des fins de ligne (LF dans le dépôt) — évite les
#  avertissements « LF will be replaced by CRLF » entre postes.
# ==============================================================

# Par défaut : détection auto, stockage en LF dans le dépôt
* text=auto eol=lf

# Fichiers texte explicitement en LF
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.jsx  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.sh   text eol=lf

# Scripts Windows : CRLF obligatoire
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# --- Fichiers binaires (aucune conversion, diff non bruité) ---
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.pdf  binary
*.woff  binary
*.woff2 binary
*.ttf  binary
*.otf  binary
*.mp4  binary
*.mov  binary
*.zip  binary
*.keystore binary
*.jks  binary
*.p12  binary
