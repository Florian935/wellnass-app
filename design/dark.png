<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<script src="./support.js"></script>
</head>
<body>
<x-dc>
<helmet>
<meta name="design_doc_mode" content="canvas">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,600;12..96,700;12..96,800&family=Hanken+Grotesk:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
<style>
  * { box-sizing: border-box; }
  :root {
    color-scheme: light;
    --txt:#33291f; --panel:#33291f; --paneltx:#f0e4d0; --panelmut:#c9b79a; --panelacc:#d9a888;
    --acc:#c0562f; --acc-rgb:192,86,47; --grn:#7c8a5b; --amber:#cc9544;
    --card:#fffaf2; --line:#ece0cd; --line2:#e0d0b6; --mut:#96856f; --mut2:#a8967d;
    --sub:#8a7458; --deep:#5c4a35; --lbl:#7a6850;
    --soft:#f3ddd0; --softline:#e6c3ae; --accdk:#a34e2c; --accdk2:#b06a4a;
    --grnbg:#e5e8d5; --grntx:#5f6b3e; --btnsoft:#e6d7bf;
    --track:#eadcc6; --track2:#e2d3ba; --chip:#faf5ec; --chipline:#e8dcc9; --seg:#e8dcc9;
    --tert:#faf3e6; --tertline:#dcc9ab; --navbg:#fbf6ee; --warnline:#ecd9c2;
    --recbadge:#f0eede; --tipline:#cdd6b4; --emptyicon:#f3ede1; --dot0:#f1e7d6;
    --stripe1:#eaddc8; --stripe2:#e3d4bc; --skel1:#ece0cd; --skel2:#f5ecdd;
    --bg1:#ece0cd; --bg2:#ddd0ba; --bg3:#d3c5ac;
  }
  :root[data-theme="dark"] {
    color-scheme: dark;
    --txt:#f4ecdd; --panel:#30271e; --paneltx:#f0e4d0; --panelmut:#c9b79a; --panelacc:#d9a888;
    --acc:#dd6e40; --acc-rgb:221,110,64; --grn:#a9ba7e; --amber:#e0b155;
    --card:#241e18; --line:#342c24; --line2:#352d24; --mut:#a4937c; --mut2:#8b7c66;
    --sub:#a2917a; --deep:#c4b298; --lbl:#9a8a71;
    --soft:#3a281d; --softline:#4a3124; --accdk:#e58a5f; --accdk2:#dd8a63;
    --grnbg:#2d3123; --grntx:#b0bd80; --btnsoft:#2d251d;
    --track:#362c22; --track2:#362c22; --chip:#241e18; --chipline:#342c24; --seg:#342c24;
    --tert:#241e18; --tertline:#3a3026; --navbg:#1b1611; --warnline:#372b20;
    --recbadge:#2b2c22; --tipline:#3c3f2a; --emptyicon:#2e2820; --dot0:#241e18;
    --stripe1:#2a221b; --stripe2:#241d16; --skel1:#342c24; --skel2:#3f352a;
    --bg1:#1a140f; --bg2:#140f0b; --bg3:#100c08;
  }
  body { margin:0; background:radial-gradient(circle at 50% 0%, var(--bg1) 0%, var(--bg2) 60%, var(--bg3) 100%); min-height:100vh; font-family:'Hanken Grotesk',system-ui,sans-serif; -webkit-font-smoothing:antialiased; color:var(--txt); padding:56px 40px 80px; }
</style>
</helmet>

<div style="max-width:1120px; margin:0 auto;">

  <!-- Masthead -->
  <div style="display:flex; align-items:center; gap:18px; margin-bottom:10px;">
    <div style="width:60px; height:60px; border-radius:19px; background:var(--acc); display:flex; align-items:center; justify-content:center; box-shadow:0 12px 26px -8px rgba(var(--acc-rgb),.55); flex:none;">
      <svg width="30" height="30" viewBox="0 0 38 38" fill="none" stroke="#fff" stroke-width="3.4" stroke-linecap="round"><rect x="12" y="12" width="4" height="14" rx="2" fill="#fff" stroke="none"/><rect x="22" y="12" width="4" height="14" rx="2" fill="#fff" stroke="none"/><path d="M16 19h6M8 19h4M26 19h4"/></svg>
    </div>
    <div style="flex:1;">
      <div style="font:700 12px 'Space Mono',monospace; color:var(--acc); letter-spacing:2px;">FITTRIO · DESIGN KIT</div>
      <h1 style="margin:2px 0 0; font:800 40px 'Bricolage Grotesque',sans-serif; color:var(--txt); letter-spacing:-1.4px;">Assets & composants</h1>
    </div>
    <button onClick="{{ toggleTheme }}" style="height:44px; padding:0 18px; border:1.5px solid var(--line2); border-radius:14px; background:var(--card); color:var(--deep); font:600 14px 'Hanken Grotesk'; cursor:pointer; display:inline-flex; align-items:center; gap:8px;">{{ themeIcon }} {{ themeLabel }}</button>
  </div>
  <p style="margin:0 0 44px; color:var(--sub); font-size:16px; max-width:620px;">Les briques graphiques standard de l'application — typographie, boutons, champs, badges et cartes — dans le langage terracotta chaud de FitTrio, en thème clair et sombre.</p>

  <!-- ══ PALETTE ══ -->
  <div style="font:700 12px 'Space Mono',monospace; color:var(--mut); letter-spacing:1.5px; margin-bottom:16px;">01 · PALETTE</div>
  <div style="display:grid; grid-template-columns:repeat(6,1fr); gap:12px; margin-bottom:56px;">
    <div style="border-radius:18px; overflow:hidden; border:1px solid var(--line); background:var(--card);"><div style="height:74px; background:var(--acc);"></div><div style="padding:11px 13px;"><div style="font-weight:700; font-size:13px;">Terracotta</div><div style="font:400 11px 'Space Mono'; color:var(--mut);">--acc</div></div></div>
    <div style="border-radius:18px; overflow:hidden; border:1px solid var(--line); background:var(--card);"><div style="height:74px; background:var(--panel);"></div><div style="padding:11px 13px;"><div style="font-weight:700; font-size:13px;">Panel</div><div style="font:400 11px 'Space Mono'; color:var(--mut);">--panel</div></div></div>
    <div style="border-radius:18px; overflow:hidden; border:1px solid var(--line); background:var(--card);"><div style="height:74px; background:var(--grn);"></div><div style="padding:11px 13px;"><div style="font-weight:700; font-size:13px;">Sauge</div><div style="font:400 11px 'Space Mono'; color:var(--mut);">--grn</div></div></div>
    <div style="border-radius:18px; overflow:hidden; border:1px solid var(--line); background:var(--card);"><div style="height:74px; background:var(--amber);"></div><div style="padding:11px 13px;"><div style="font-weight:700; font-size:13px;">Ambre</div><div style="font:400 11px 'Space Mono'; color:var(--mut);">--amber</div></div></div>
    <div style="border-radius:18px; overflow:hidden; border:1px solid var(--line); background:var(--card);"><div style="height:74px; background:var(--card); border-bottom:1px solid var(--line);"></div><div style="padding:11px 13px;"><div style="font-weight:700; font-size:13px;">Surface</div><div style="font:400 11px 'Space Mono'; color:var(--mut);">--card</div></div></div>
    <div style="border-radius:18px; overflow:hidden; border:1px solid var(--line); background:var(--card);"><div style="height:74px; background:var(--mut);"></div><div style="padding:11px 13px;"><div style="font-weight:700; font-size:13px;">Taupe</div><div style="font:400 11px 'Space Mono'; color:var(--mut);">--mut</div></div></div>
  </div>

  <!-- ══ TYPOGRAPHIE ══ -->
  <div style="font:700 12px 'Space Mono',monospace; color:var(--mut); letter-spacing:1.5px; margin-bottom:16px;">02 · TYPOGRAPHIE</div>
  <div style="background:var(--card); border:1px solid var(--line); border-radius:24px; padding:34px 36px; margin-bottom:56px; display:flex; flex-direction:column; gap:22px;">
    <div style="display:flex; align-items:baseline; gap:20px; border-bottom:1px solid var(--line); padding-bottom:22px;">
      <span style="width:130px; flex:none; font:400 11px 'Space Mono'; color:var(--mut);">Display · 46/800</span>
      <div style="font:800 46px/.98 'Bricolage Grotesque'; letter-spacing:-1.5px;">Trois piliers.<br>Une routine.</div>
    </div>
    <div style="display:flex; align-items:baseline; gap:20px; border-bottom:1px solid var(--line); padding-bottom:22px;">
      <span style="width:130px; flex:none; font:400 11px 'Space Mono'; color:var(--mut);">Titre · 28/700</span>
      <div style="font:700 28px 'Bricolage Grotesque'; letter-spacing:-.6px;">Faisons connaissance</div>
    </div>
    <div style="display:flex; align-items:baseline; gap:20px; border-bottom:1px solid var(--line); padding-bottom:22px;">
      <span style="width:130px; flex:none; font:400 11px 'Space Mono'; color:var(--mut);">Sous-titre · 20/700</span>
      <div style="font:700 20px 'Bricolage Grotesque';">Push / Pull / Legs</div>
    </div>
    <div style="display:flex; align-items:baseline; gap:20px; border-bottom:1px solid var(--line); padding-bottom:22px;">
      <span style="width:130px; flex:none; font:400 11px 'Space Mono'; color:var(--mut);">Corps · 15/400</span>
      <div style="font-size:15px; line-height:1.5; color:var(--sub); max-width:440px;">Muscu, running et alimentation qui se parlent enfin. Ton corps, une seule appli.</div>
    </div>
    <div style="display:flex; align-items:baseline; gap:20px; border-bottom:1px solid var(--line); padding-bottom:22px;">
      <span style="width:130px; flex:none; font:400 11px 'Space Mono'; color:var(--mut);">Label · 13/700</span>
      <div style="font:700 13px 'Hanken Grotesk'; color:var(--mut); letter-spacing:.4px;">SÉANCE DU JOUR · 18:30</div>
    </div>
    <div style="display:flex; align-items:baseline; gap:20px;">
      <span style="width:130px; flex:none; font:400 11px 'Space Mono'; color:var(--mut);">Chiffres · Mono</span>
      <div style="font:700 30px 'Space Mono'; color:var(--acc);">00:24:18 <span style="color:var(--txt);">·</span> 85 kg</div>
    </div>
  </div>

  <!-- ══ BOUTONS ══ -->
  <div style="font:700 12px 'Space Mono',monospace; color:var(--mut); letter-spacing:1.5px; margin-bottom:16px;">03 · BOUTONS</div>
  <div style="background:var(--card); border:1px solid var(--line); border-radius:24px; padding:34px 36px; margin-bottom:20px;">
    <div style="display:flex; flex-wrap:wrap; gap:16px; align-items:center; margin-bottom:28px;">
      <button style="height:56px; padding:0 30px; border:none; border-radius:18px; background:var(--acc); color:#fff; font:700 17px 'Hanken Grotesk'; cursor:pointer; box-shadow:0 10px 24px -8px rgba(var(--acc-rgb),.55);">Créer mon compte</button>
      <button style="height:52px; padding:0 26px; border:1.5px solid var(--line2); border-radius:18px; background:transparent; color:var(--deep); font:600 16px 'Hanken Grotesk'; cursor:pointer;">J'ai déjà un compte</button>
      <button style="height:48px; padding:0 24px; border:none; border-radius:14px; background:var(--acc); color:#fff; font:700 15px 'Hanken Grotesk'; cursor:pointer; display:inline-flex; align-items:center; gap:8px;"><svg width="14" height="15" viewBox="0 0 14 15" fill="#fff"><path d="M2 1.5l11 6-11 6z"/></svg> Démarrer</button>
    </div>
    <div style="display:flex; flex-wrap:wrap; gap:16px; align-items:center; margin-bottom:28px;">
      <button style="height:52px; padding:0 22px; border:1.5px solid var(--line2); border-radius:16px; background:var(--card); color:var(--txt); font:600 15px 'Hanken Grotesk'; cursor:pointer; display:inline-flex; align-items:center; gap:10px;"><span style="font:700 16px 'Space Mono'; color:var(--acc);">G</span> Continuer avec Google</button>
      <button style="height:52px; padding:0 22px; border:1.5px dashed var(--tertline); border-radius:16px; background:var(--tert); color:var(--acc); font:700 14px 'Hanken Grotesk'; cursor:pointer;">+ Créer un exercice perso</button>
    </div>
    <div style="display:flex; flex-wrap:wrap; gap:16px; align-items:center;">
      <button style="width:46px; height:46px; border:none; border-radius:15px; background:var(--btnsoft); color:var(--deep); cursor:pointer; font-size:20px;">‹</button>
      <button style="width:46px; height:46px; border:none; border-radius:15px; background:var(--panel); color:var(--paneltx); font:700 17px 'Space Mono'; cursor:pointer;">A</button>
      <button style="width:46px; height:46px; border:none; border-radius:14px; background:var(--acc); color:#fff; cursor:pointer; display:inline-flex; align-items:center; justify-content:center;"><svg width="18" height="18" viewBox="0 0 13 13" fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round"><path d="M2 7l3 3 6-7"/></svg></button>
      <button style="width:78px; height:78px; border:none; border-radius:50%; background:var(--acc); color:#fff; font:700 15px 'Hanken Grotesk'; cursor:pointer; box-shadow:0 12px 30px -6px rgba(var(--acc-rgb),.6);">Go</button>
      <span style="font:400 11px 'Space Mono'; color:var(--mut);">icône · avatar · valider · FAB</span>
    </div>
  </div>
  <p style="margin:0 0 56px; font-size:13px; color:var(--mut);">Primaire terracotta · secondaire contour · tertiaire pointillé · icônes 46px minimum pour la cible tactile.</p>

  <!-- ══ CHAMPS & CHIPS ══ -->
  <div style="font:700 12px 'Space Mono',monospace; color:var(--mut); letter-spacing:1.5px; margin-bottom:16px;">04 · CHAMPS & PILLS</div>
  <div style="display:grid; grid-template-columns:1fr 1fr; gap:20px; margin-bottom:56px;">
    <div style="background:var(--card); border:1px solid var(--line); border-radius:24px; padding:30px 32px;">
      <label style="display:block; font:600 13px 'Hanken Grotesk'; color:var(--lbl); margin-bottom:7px;">Adresse e-mail</label>
      <div style="height:52px; border:1.5px solid var(--line2); border-radius:16px; background:var(--card); display:flex; align-items:center; padding:0 16px; color:var(--txt); margin-bottom:18px;">alex@exemple.com</div>
      <label style="display:block; font:600 13px 'Hanken Grotesk'; color:var(--lbl); margin-bottom:7px;">Mot de passe</label>
      <div style="height:52px; border:1.5px solid var(--acc); border-radius:16px; background:var(--card); display:flex; align-items:center; justify-content:space-between; padding:0 16px; color:var(--txt); letter-spacing:3px;">••••••••<span style="letter-spacing:0; font-size:13px; color:var(--acc); font-weight:600;">Afficher</span></div>
      <div style="height:48px; margin-top:18px; border-radius:15px; background:var(--card); border:1px solid var(--chipline); display:flex; align-items:center; gap:10px; padding:0 16px; color:var(--mut2);"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4-4"/></svg><span style="font-size:15px;">Rechercher un exercice…</span></div>
    </div>
    <div style="background:var(--card); border:1px solid var(--line); border-radius:24px; padding:30px 32px;">
      <div style="font:600 13px 'Hanken Grotesk'; color:var(--lbl); margin-bottom:12px;">Filtres & restrictions</div>
      <div style="display:flex; flex-wrap:wrap; gap:8px; margin-bottom:20px;">
        <span style="padding:8px 15px; border-radius:999px; background:var(--acc); color:#fff; font-size:13px; font-weight:700;">Tous</span>
        <span style="padding:8px 15px; border-radius:999px; background:var(--card); border:1px solid var(--chipline); color:var(--sub); font-size:13px;">Pecs</span>
        <span style="padding:8px 15px; border-radius:999px; background:var(--card); border:1px solid var(--chipline); color:var(--sub); font-size:13px;">Dos</span>
        <span style="padding:8px 15px; border-radius:999px; background:var(--card); border:1px solid var(--chipline); color:var(--sub); font-size:13px;">⭐ Favoris</span>
      </div>
      <div style="display:flex; flex-wrap:wrap; gap:8px;">
        <span style="padding:8px 14px; border-radius:999px; background:var(--grnbg); color:var(--grntx); font-size:13px; font-weight:600;">Végétarien ✓</span>
        <span style="padding:8px 14px; border-radius:999px; background:var(--card); border:1px solid var(--line2); color:var(--sub); font-size:13px;">Sans gluten</span>
        <span style="padding:6px 12px; border-radius:999px; background:var(--soft); color:var(--accdk); font-size:12px; font-weight:700;">Pectoraux</span>
        <span style="padding:6px 12px; border-radius:999px; background:var(--chip); border:1px solid var(--chipline); color:var(--sub); font-size:12px;">Triceps</span>
      </div>
    </div>
  </div>

  <!-- ══ BADGES & JAUGES ══ -->
  <div style="font:700 12px 'Space Mono',monospace; color:var(--mut); letter-spacing:1.5px; margin-bottom:16px;">05 · BADGES, JAUGES & TOGGLES</div>
  <div style="display:grid; grid-template-columns:1fr 1fr; gap:20px; margin-bottom:56px;">
    <div style="background:var(--card); border:1px solid var(--line); border-radius:24px; padding:30px 32px; display:flex; flex-direction:column; gap:18px;">
      <div style="display:flex; flex-wrap:wrap; gap:10px; align-items:center;">
        <span style="padding:6px 12px; border-radius:999px; background:var(--soft); color:var(--accdk); font:700 12px 'Hanken Grotesk';">72% ✓</span>
        <span style="padding:6px 12px; border-radius:999px; background:var(--grnbg); color:var(--grntx); font:700 12px 'Hanken Grotesk';">↓ 0,8 kg</span>
        <span style="padding:6px 12px; border-radius:999px; background:var(--recbadge); color:var(--grntx); font:700 12px 'Hanken Grotesk';">1 🏆 Record</span>
        <span style="padding:6px 12px; border-radius:999px; background:var(--tert); border:1px solid var(--warnline); color:var(--amber); font:700 12px 'Hanken Grotesk';">4 ⚠</span>
      </div>
      <div>
        <div style="display:flex; justify-content:space-between; font-size:12px; margin-bottom:6px;"><span style="color:var(--lbl); font-weight:600;">Protéines</span><span style="font:700 11px 'Space Mono'; color:var(--mut);">124/165g</span></div>
        <div style="height:8px; border-radius:5px; background:var(--track);"><div style="height:100%; width:75%; background:var(--acc); border-radius:5px;"></div></div>
      </div>
      <div>
        <div style="display:flex; justify-content:space-between; font-size:12px; margin-bottom:6px;"><span style="color:var(--lbl); font-weight:600;">Glucides</span><span style="font:700 11px 'Space Mono'; color:var(--mut);">180/290g</span></div>
        <div style="height:8px; border-radius:5px; background:var(--track);"><div style="height:100%; width:62%; background:var(--amber); border-radius:5px;"></div></div>
      </div>
      <div>
        <div style="display:flex; justify-content:space-between; font-size:12px; margin-bottom:6px;"><span style="color:var(--lbl); font-weight:600;">Lipides</span><span style="font:700 11px 'Space Mono'; color:var(--mut);">52/78g</span></div>
        <div style="height:8px; border-radius:5px; background:var(--track);"><div style="height:100%; width:66%; background:var(--grn); border-radius:5px;"></div></div>
      </div>
    </div>
    <div style="background:var(--card); border:1px solid var(--line); border-radius:24px; padding:30px 32px; display:flex; flex-direction:column; gap:20px; align-items:flex-start;">
      <svg width="96" height="96" viewBox="0 0 96 96"><circle cx="48" cy="48" r="38" fill="none" stroke="var(--track)" stroke-width="10"/><circle cx="48" cy="48" r="38" fill="none" stroke="var(--acc)" stroke-width="10" stroke-linecap="round" stroke-dasharray="238.8" stroke-dashoffset="72" transform="rotate(-90 48 48)"/><text x="48" y="45" text-anchor="middle" font-family="Bricolage Grotesque" font-size="21" font-weight="800" fill="var(--txt)">810</text><text x="48" y="60" text-anchor="middle" font-family="Hanken Grotesk" font-size="10" fill="var(--mut)">restantes</text></svg>
      <div style="display:flex; align-items:center; gap:14px;">
        <div style="display:flex; background:var(--seg); border-radius:11px; padding:3px;">
          <span style="padding:8px 16px; border-radius:9px; background:var(--panel); color:var(--paneltx); font:600 13px 'Hanken Grotesk';">Clair</span>
          <span style="padding:8px 16px; border-radius:9px; color:var(--lbl); font:600 13px 'Hanken Grotesk';">Sombre</span>
        </div>
        <div style="width:24px; height:24px; border-radius:50%; background:var(--acc); box-shadow:inset 0 0 0 3px var(--card), inset 0 0 0 4px var(--acc);"></div>
        <div style="width:24px; height:24px; border-radius:50%; box-shadow:inset 0 0 0 2px var(--line2);"></div>
      </div>
    </div>
  </div>

  <!-- ══ CARTES ══ -->
  <div style="font:700 12px 'Space Mono',monospace; color:var(--mut); letter-spacing:1.5px; margin-bottom:16px;">06 · CARTES</div>
  <div style="display:grid; grid-template-columns:1.2fr 1fr; gap:20px; margin-bottom:56px;">
    <div style="background:var(--panel); border-radius:24px; padding:24px; color:var(--paneltx); position:relative; overflow:hidden;">
      <div style="position:absolute; right:-30px; top:-30px; width:130px; height:130px; border-radius:50%; background:rgba(var(--acc-rgb),.28);"></div>
      <div style="font:600 13px 'Hanken Grotesk'; color:var(--panelacc); letter-spacing:.4px;">SÉANCE DU JOUR · 18:30</div>
      <div style="font:700 24px 'Bricolage Grotesque'; margin:6px 0 3px; color:#fff;">Push — Pecs / Épaules</div>
      <div style="font-size:14px; color:var(--panelmut); margin-bottom:18px;">6 exercices · ~55 min · PPL Semaine 3</div>
      <button style="height:48px; padding:0 26px; border:none; border-radius:14px; background:var(--acc); color:#fff; font:700 15px 'Hanken Grotesk'; cursor:pointer; display:inline-flex; align-items:center; gap:8px;"><svg width="14" height="15" viewBox="0 0 14 15" fill="#fff"><path d="M2 1.5l11 6-11 6z"/></svg> Démarrer</button>
    </div>
    <div style="background:var(--card); border:1px solid var(--line); border-radius:22px; padding:18px; display:flex; flex-direction:column;">
      <div style="font-size:12.5px; color:var(--mut); font-weight:600; margin-bottom:10px;">POIDS</div>
      <div style="font:800 30px 'Bricolage Grotesque'; letter-spacing:-1px;">74,2<span style="font-size:15px; color:var(--mut);"> kg</span></div>
      <div style="font-size:12.5px; color:var(--grn); font-weight:600; margin:2px 0 12px;">↓ 0,8 kg sur 7 j</div>
      <svg width="100%" height="42" viewBox="0 0 120 42" preserveAspectRatio="none"><polyline points="0,10 20,14 40,12 60,20 80,18 100,28 120,26" fill="none" stroke="var(--acc)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </div>
    <div style="background:var(--card); border:1px solid var(--line); border-radius:16px; padding:14px 16px; display:flex; align-items:center; gap:14px;">
      <div style="width:44px; height:44px; border-radius:12px; background:repeating-linear-gradient(135deg,var(--stripe1) 0 6px,var(--stripe2) 6px 12px); flex:none;"></div>
      <div style="flex:1;"><div style="font:700 15px 'Hanken Grotesk'; color:var(--txt);">Développé couché</div><div style="font-size:12.5px; color:var(--mut);">Pectoraux · Barre</div></div>
      <span style="color:var(--acc);">⭐</span>
    </div>
    <div style="background:var(--soft); border:1.5px solid var(--softline); border-radius:16px; padding:14px 16px; display:flex; align-items:center; gap:12px;">
      <span style="font-size:22px;">🏆</span>
      <div><div style="font:700 14px 'Hanken Grotesk'; color:var(--accdk);">Développé couché · 85 kg × 8</div><div style="font-size:12px; color:var(--accdk2);">1RM estimé 108 kg (+3 kg)</div></div>
    </div>
  </div>

  <!-- ══ SÉLECTION ══ -->
  <div style="font:700 12px 'Space Mono',monospace; color:var(--mut); letter-spacing:1.5px; margin-bottom:16px;">07 · SÉLECTION</div>
  <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:20px; margin-bottom:56px;">
    <div style="background:var(--card); border:1px solid var(--line); border-radius:24px; padding:30px 32px; display:flex; flex-direction:column; gap:16px;">
      <div style="font:600 13px 'Hanken Grotesk'; color:var(--lbl);">Cases à cocher</div>
      <div style="display:flex; align-items:center; gap:12px;"><div style="width:22px; height:22px; border-radius:7px; background:var(--acc); flex:none; display:flex; align-items:center; justify-content:center;"><svg width="13" height="13" viewBox="0 0 13 13" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round"><path d="M2 7l3 3 6-7"/></svg></div><span style="font-size:14px; color:var(--txt);">Jour d'entraînement</span></div>
      <div style="display:flex; align-items:center; gap:12px;"><div style="width:22px; height:22px; border-radius:7px; background:transparent; box-shadow:inset 0 0 0 1.5px var(--line2); flex:none;"></div><span style="font-size:14px; color:var(--sub);">Rappel hydratation</span></div>
      <div style="font:600 13px 'Hanken Grotesk'; color:var(--lbl); margin-top:6px;">Boutons radio</div>
      <div style="display:flex; align-items:center; gap:12px;"><div style="width:22px; height:22px; border-radius:50%; background:var(--acc); box-shadow:inset 0 0 0 3px var(--card), inset 0 0 0 4px var(--acc); flex:none;"></div><span style="font-size:14px; color:var(--txt);">Prise de masse</span></div>
      <div style="display:flex; align-items:center; gap:12px;"><div style="width:22px; height:22px; border-radius:50%; box-shadow:inset 0 0 0 2px var(--line2); flex:none;"></div><span style="font-size:14px; color:var(--sub);">Perte de poids</span></div>
    </div>
    <div style="background:var(--card); border:1px solid var(--line); border-radius:24px; padding:30px 32px; display:flex; flex-direction:column; gap:20px;">
      <div style="font:600 13px 'Hanken Grotesk'; color:var(--lbl);">Interrupteurs</div>
      <div style="display:flex; justify-content:space-between; align-items:center;"><span style="font-size:14px; color:var(--txt); font-weight:600;">Suivi GPS auto</span><div style="width:48px; height:28px; border-radius:999px; background:var(--acc); position:relative;"><div style="width:22px; height:22px; border-radius:50%; background:#fff; position:absolute; top:3px; right:3px;"></div></div></div>
      <div style="display:flex; justify-content:space-between; align-items:center;"><span style="font-size:14px; color:var(--txt); font-weight:600;">Auto-pause</span><div style="width:48px; height:28px; border-radius:999px; background:var(--acc); position:relative;"><div style="width:22px; height:22px; border-radius:50%; background:#fff; position:absolute; top:3px; right:3px;"></div></div></div>
      <div style="display:flex; justify-content:space-between; align-items:center;"><span style="font-size:14px; color:var(--sub);">Sons de série</span><div style="width:48px; height:28px; border-radius:999px; background:var(--line2); position:relative;"><div style="width:22px; height:22px; border-radius:50%; background:var(--card); position:absolute; top:3px; left:3px;"></div></div></div>
    </div>
    <div style="background:var(--card); border:1px solid var(--line); border-radius:24px; padding:30px 32px; display:flex; flex-direction:column; gap:18px;">
      <div style="font:600 13px 'Hanken Grotesk'; color:var(--lbl);">Compteur</div>
      <div style="display:flex; align-items:center; gap:14px;">
        <button style="width:44px; height:44px; border:1.5px solid var(--line2); border-radius:13px; background:var(--card); color:var(--deep); font-size:22px; cursor:pointer;">−</button>
        <div style="flex:1; text-align:center;"><div style="font:700 26px 'Space Mono'; color:var(--txt);">82</div><div style="font-size:11px; color:var(--mut);">kg</div></div>
        <button style="width:44px; height:44px; border:none; border-radius:13px; background:var(--acc); color:#fff; font-size:22px; cursor:pointer;">+</button>
      </div>
      <div style="display:flex; align-items:center; gap:14px;">
        <button style="width:44px; height:44px; border:1.5px solid var(--line2); border-radius:13px; background:var(--card); color:var(--deep); font-size:22px; cursor:pointer;">−</button>
        <div style="flex:1; text-align:center;"><div style="font:700 26px 'Space Mono'; color:var(--txt);">8</div><div style="font-size:11px; color:var(--mut);">reps</div></div>
        <button style="width:44px; height:44px; border:none; border-radius:13px; background:var(--acc); color:#fff; font-size:22px; cursor:pointer;">+</button>
      </div>
    </div>
  </div>

  <!-- ══ NAVIGATION ══ -->
  <div style="font:700 12px 'Space Mono',monospace; color:var(--mut); letter-spacing:1.5px; margin-bottom:16px;">08 · NAVIGATION</div>
  <div style="display:grid; grid-template-columns:1fr 1fr; gap:20px; margin-bottom:56px;">
    <div style="background:var(--card); border:1px solid var(--line); border-radius:24px; padding:30px 32px; display:flex; flex-direction:column; gap:20px;">
      <div style="display:flex; background:var(--seg); border-radius:14px; padding:4px;">
        <div style="flex:1; text-align:center; padding:9px; border-radius:11px; background:var(--card); font:700 14px 'Hanken Grotesk'; color:var(--txt); box-shadow:0 1px 3px rgba(0,0,0,.06);">Progression</div>
        <div style="flex:1; text-align:center; padding:9px; color:var(--sub); font:600 14px 'Hanken Grotesk';">Historique</div>
      </div>
      <div style="display:flex; gap:8px;">
        <span style="padding:6px 13px; border-radius:999px; background:var(--panel); color:#fff; font:700 12px 'Hanken Grotesk';">3 mois</span>
        <span style="padding:6px 13px; border-radius:999px; background:var(--card); border:1px solid var(--chipline); color:var(--sub); font-size:12px;">4 sem</span>
        <span style="padding:6px 13px; border-radius:999px; background:var(--card); border:1px solid var(--chipline); color:var(--sub); font-size:12px;">1 an</span>
      </div>
      <div style="display:flex; align-items:center; gap:14px;">
        <div style="flex:1; height:7px; border-radius:4px; background:var(--track2); overflow:hidden;"><div style="height:100%; width:60%; border-radius:4px; background:var(--acc);"></div></div>
        <span style="font:700 13px 'Space Mono'; color:var(--mut);">3/5</span>
      </div>
    </div>
    <div style="background:var(--navbg); border:1px solid var(--line); border-radius:24px; padding:14px 16px 10px; display:flex; align-items:flex-end;">
      <div style="flex:1; display:flex; flex-direction:column; align-items:center; gap:4px; color:var(--acc);"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11l9-8 9 8"/><path d="M5 10v10h14V10"/></svg><span style="font-size:10.5px; font-weight:600;">Accueil</span></div>
      <div style="flex:1; display:flex; flex-direction:column; align-items:center; gap:4px; color:var(--mut2);"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8v8M18 8v8M4 10v4M20 10v4M6 12h12"/></svg><span style="font-size:10.5px; font-weight:600;">Muscu</span></div>
      <div style="flex:1; display:flex; flex-direction:column; align-items:center; gap:4px; color:var(--mut2);"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h4l2-4 3 8 2-5 2 3h5"/></svg><span style="font-size:10.5px; font-weight:600;">Running</span></div>
      <div style="flex:1; display:flex; flex-direction:column; align-items:center; gap:4px; color:var(--mut2);"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4v6a4 4 0 008 0V4M8 4v16M17 4c-1.5 0-2 2-2 5s.5 4 2 4 2-1 2-4-.5-5-2-5zM17 13v7"/></svg><span style="font-size:10.5px; font-weight:600;">Alim</span></div>
    </div>
  </div>

  <!-- ══ NOTIFICATIONS ══ -->
  <div style="font:700 12px 'Space Mono',monospace; color:var(--mut); letter-spacing:1.5px; margin-bottom:16px;">09 · NOTIFICATIONS & ALERTES</div>
  <div style="display:grid; grid-template-columns:1fr 1fr; gap:20px; margin-bottom:56px;">
    <div style="display:flex; flex-direction:column; gap:14px;">
      <div style="background:var(--grn); color:#fff; padding:14px 20px; border-radius:18px; box-shadow:0 16px 40px -14px rgba(0,0,0,.35); display:flex; align-items:center; gap:12px;"><span style="font-size:24px;">🏆</span><div><div style="font:800 15px 'Bricolage Grotesque';">Nouveau record !</div><div style="font-size:13px; opacity:.9;">Développé couché · 85 kg × 8</div></div></div>
      <div style="background:var(--panel); color:var(--paneltx); padding:14px 18px; border-radius:16px; display:flex; align-items:center; gap:12px;"><svg width="18" height="18" viewBox="0 0 13 13" fill="none" stroke="var(--grn)" stroke-width="2.4" stroke-linecap="round"><path d="M2 7l3 3 6-7"/></svg><span style="font-size:14px;">Séance enregistrée</span><span style="margin-left:auto; color:var(--panelacc); font-size:13px; font-weight:700;">Annuler</span></div>
    </div>
    <div style="display:flex; flex-direction:column; gap:14px;">
      <div style="background:var(--tert); border:1px solid var(--warnline); border-radius:16px; padding:14px 16px; display:flex; gap:11px; align-items:flex-start;"><span style="font-size:18px; line-height:1.2;">⚠️</span><div style="font-size:12.5px; color:var(--accdk); line-height:1.45;">Déséquilibre détecté : peu de volume dos ces 2 semaines. Pense à ajouter du tirage.</div></div>
      <div style="background:var(--grnbg); border:1px solid var(--tipline); border-radius:16px; padding:14px 16px; display:flex; gap:11px; align-items:flex-start;"><span style="font-size:18px; line-height:1.2;">💡</span><div style="font-size:12.5px; color:var(--grntx); line-height:1.45;">Il te reste 810 kcal aujourd'hui. Un dîner riche en protéines t'aiderait à atteindre ton objectif.</div></div>
    </div>
  </div>

  <!-- ══ TIMER & CALENDRIER ══ -->
  <div style="font:700 12px 'Space Mono',monospace; color:var(--mut); letter-spacing:1.5px; margin-bottom:16px;">10 · TIMER & RÉGULARITÉ</div>
  <div style="display:grid; grid-template-columns:auto 1fr; gap:20px; margin-bottom:56px;">
    <div style="background:var(--card); border:1px solid var(--line); border-radius:24px; padding:30px 40px; text-align:center;">
      <div style="font:600 12px 'Hanken Grotesk'; color:var(--mut); letter-spacing:.5px; margin-bottom:12px;">REPOS</div>
      <div style="position:relative; width:130px; height:130px;">
        <svg width="130" height="130" viewBox="0 0 130 130"><circle cx="65" cy="65" r="52" fill="none" stroke="var(--track2)" stroke-width="12"/><circle cx="65" cy="65" r="52" fill="none" stroke="var(--acc)" stroke-width="12" stroke-linecap="round" stroke-dasharray="326.7" stroke-dashoffset="98" transform="rotate(-90 65 65)"/></svg>
        <div style="position:absolute; inset:0; display:flex; align-items:center; justify-content:center; font:800 34px 'Bricolage Grotesque'; letter-spacing:-1px;">1:03</div>
      </div>
    </div>
    <div style="background:var(--card); border:1px solid var(--line); border-radius:24px; padding:30px 32px;">
      <div style="display:flex; align-items:baseline; justify-content:space-between; margin-bottom:18px;"><div style="font-size:12.5px; color:var(--mut); font-weight:600;">RÉGULARITÉ</div><div><span style="font:800 24px 'Bricolage Grotesque'; color:var(--acc);">12</span><span style="font-size:13px; color:var(--sub); font-weight:600;"> jours 🔥</span></div></div>
      <div style="display:flex; justify-content:space-between;">
        <div style="text-align:center;"><div style="width:38px; height:38px; border-radius:12px; background:var(--acc); display:flex; align-items:center; justify-content:center; color:#fff;"><svg width="16" height="16" viewBox="0 0 13 13" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round"><path d="M2 7l3 3 6-7"/></svg></div><div style="font-size:11px; color:var(--mut2); margin-top:6px;">L</div></div>
        <div style="text-align:center;"><div style="width:38px; height:38px; border-radius:12px; background:var(--acc); display:flex; align-items:center; justify-content:center; color:#fff;"><svg width="16" height="16" viewBox="0 0 13 13" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round"><path d="M2 7l3 3 6-7"/></svg></div><div style="font-size:11px; color:var(--mut2); margin-top:6px;">M</div></div>
        <div style="text-align:center;"><div style="width:38px; height:38px; border-radius:12px; background:var(--grnbg); display:flex; align-items:center; justify-content:center; color:var(--grn); font-size:12px; font-weight:700;">R</div><div style="font-size:11px; color:var(--mut2); margin-top:6px;">Repos</div></div>
        <div style="text-align:center;"><div style="width:38px; height:38px; border-radius:12px; background:var(--acc); display:flex; align-items:center; justify-content:center; color:#fff;"><svg width="16" height="16" viewBox="0 0 13 13" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round"><path d="M2 7l3 3 6-7"/></svg></div><div style="font-size:11px; color:var(--mut2); margin-top:6px;">J</div></div>
        <div style="text-align:center;"><div style="width:38px; height:38px; border-radius:12px; background:var(--card); border:2px dashed var(--line2); display:flex; align-items:center; justify-content:center; color:var(--acc); font-size:16px;">·</div><div style="font-size:11px; color:var(--acc); margin-top:6px; font-weight:700;">Auj.</div></div>
        <div style="text-align:center;"><div style="width:38px; height:38px; border-radius:12px; background:var(--dot0);"></div><div style="font-size:11px; color:var(--mut2); margin-top:6px;">S</div></div>
        <div style="text-align:center;"><div style="width:38px; height:38px; border-radius:12px; background:var(--dot0);"></div><div style="font-size:11px; color:var(--mut2); margin-top:6px;">D</div></div>
      </div>
    </div>
  </div>

  <!-- ══ ÉTAT VIDE ══ -->
  <div style="font:700 12px 'Space Mono',monospace; color:var(--mut); letter-spacing:1.5px; margin-bottom:16px;">11 · ÉTAT VIDE & CHARGEMENT</div>
  <div style="display:grid; grid-template-columns:1fr 1fr; gap:20px;">
    <div style="background:var(--card); border:1px solid var(--line); border-radius:24px; padding:44px 32px; text-align:center;">
      <div style="width:64px; height:64px; border-radius:20px; background:var(--emptyicon); display:flex; align-items:center; justify-content:center; margin:0 auto 16px; font-size:30px;">🍽️</div>
      <div style="font:700 18px 'Bricolage Grotesque'; color:var(--txt); margin-bottom:4px;">Aucun repas ajouté</div>
      <div style="font-size:14px; color:var(--mut); margin-bottom:20px; max-width:260px; margin-left:auto; margin-right:auto;">Commence à noter tes repas pour suivre tes calories et macros.</div>
      <button style="height:46px; padding:0 24px; border:none; border-radius:14px; background:var(--acc); color:#fff; font:700 14px 'Hanken Grotesk'; cursor:pointer;">+ Ajouter un repas</button>
    </div>
    <div style="background:var(--card); border:1px solid var(--line); border-radius:24px; padding:30px 32px; display:flex; flex-direction:column; gap:14px; justify-content:center;">
      <div style="height:16px; width:55%; border-radius:6px; background:linear-gradient(90deg,var(--skel1),var(--skel2),var(--skel1));"></div>
      <div style="height:52px; border-radius:16px; background:linear-gradient(90deg,var(--skel1),var(--skel2),var(--skel1));"></div>
      <div style="height:52px; border-radius:16px; background:linear-gradient(90deg,var(--skel1),var(--skel2),var(--skel1));"></div>
      <div style="height:16px; width:35%; border-radius:6px; background:linear-gradient(90deg,var(--skel1),var(--skel2),var(--skel1));"></div>
      <div style="font:400 11px 'Space Mono'; color:var(--mut); margin-top:6px;">Skeleton · placeholders de chargement</div>
    </div>
  </div>

</div>
</x-dc>
<script type="text/x-dc" data-dc-script>
class Component extends DCLogic {
  state = { theme: 'light' };
  componentDidMount() {
    let t = 'light';
    try { t = localStorage.getItem('fittrio-theme') || 'light'; } catch (e) {}
    this.applyTheme(t);
  }
  applyTheme(t) {
    try { document.documentElement.setAttribute('data-theme', t); localStorage.setItem('fittrio-theme', t); } catch (e) {}
    this.setState({ theme: t });
  }
  toggleTheme() { this.applyTheme(this.state.theme === 'dark' ? 'light' : 'dark'); }
  renderVals() {
    const dark = this.state.theme === 'dark';
    return {
      toggleTheme: () => this.toggleTheme(),
      themeIcon: dark ? '☀️' : '🌙',
      themeLabel: dark ? 'Clair' : 'Sombre',
    };
  }
}
</script>
</body>
</html>
